PH.Cleanup = {
    speed = function()
        local ch = LocalPlayer.Character
        if ch and ch:FindFirstChildOfClass("Humanoid") then ch.Humanoid.WalkSpeed = 16 end
    end,
    jump = function()
        local ch = LocalPlayer.Character
        if ch and ch:FindFirstChildOfClass("Humanoid") then
            ch.Humanoid.UseJumpPower = true
            ch.Humanoid.JumpPower = 50
        end
    end,
    fly = function()
        if Instances.flyBV then Instances.flyBV:Destroy(); Instances.flyBV=nil end
        if Instances.flyBG then Instances.flyBG:Destroy(); Instances.flyBG=nil end
    end,
    noclip = function()
        local ch = LocalPlayer.Character
        if ch then for _,p in ipairs(ch:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide=true end end end
    end,
    fullbright = function()
        Lighting.Brightness = 1
        Lighting.ClockTime = 14
        Lighting.FogEnd = 100000
    end,
    skybox = function()
        if Instances.sky then Instances.sky:Destroy(); Instances.sky=nil end
    end,
    fov = function() Camera.FieldOfView = 70 end,
    chams = function()
        for _,p in ipairs(Players:GetPlayers()) do
            if p.Character then
                for _,part in ipairs(p.Character:GetDescendants()) do
                    if part:IsA("BasePart") and part:FindFirstChild("PH_Cham") then
                        part.PH_Cham:Destroy()
                    end
                end
            end
        end
    end,
    expander = function()
        for _,p in ipairs(Players:GetPlayers()) do
            if p.Character then
                for _,part in ipairs(p.Character:GetDescendants()) do
                    if part:IsA("BasePart") and part:FindFirstChild("PH_OrigSize") then
                        part.Size = part.PH_OrigSize.Value
                        part.PH_OrigSize:Destroy()
                        if part:FindFirstChild("PH_OrigTrans") then
                            part.Transparency = part.PH_OrigTrans.Value
                            part.PH_OrigTrans:Destroy()
                        end
                    end
                end
            end
        end
    end,
    esp = function()
        for _,d in ipairs(Drawings) do pcall(function() d:Remove() end) end
        PH.Drawings = {}
        Drawings = PH.Drawings
    end,
    crosshair = function()
        if Instances.crosshair then Instances.crosshair:Destroy(); Instances.crosshair=nil end
    end,
    china = function()
        for _,p in ipairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("PH_China") then p.Character.PH_China:Destroy() end
        end
    end,
    headdot = function()
        for _,p in ipairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("PH_HeadDot") then p.Character.PH_HeadDot:Destroy() end
        end
    end,
    watermark = function()
        if Instances.watermark then Instances.watermark:Destroy(); Instances.watermark=nil end
    end,
}
PH.disableAll = function()
    for _,fn in pairs(PH.Cleanup) do pcall(fn) end
end

