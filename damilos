function Visual:createBox()
    local box = Drawing.new("Square"); box.Visible=false; box.Thickness=1
    box.Filled=false; box.Color=Color3.fromRGB(255,255,255); return box
end
function Visual:createText(size, color)
    local t = Drawing.new("Text"); t.Visible=false; t.Size=size or 14
    t.Center=false; t.Outline=true; t.Color=color or Color3.fromRGB(255,255,255); return t
end
function Visual:createLine(color, thickness)
    local l = Drawing.new("Line"); l.Visible=false; l.Thickness=thickness or 1
    l.Color=color or Color3.fromRGB(255,255,255); return l
end
function Visual:createCircle(color, thickness, filled)
    local c = Drawing.new("Circle"); c.Visible=false; c.Thickness=thickness or 1
    c.Filled=filled or false; c.Color=color or Color3.fromRGB(255,255,255); return c
end

function Visual:initPlayerESP(plr)
    if self.drawings[plr] then return end
    self.drawings[plr] = {
        box=self:createBox(), name=self:createText(14),
        health=self:createText(12, Color3.fromRGB(0,255,0)),
        distance=self:createText(12, Color3.fromRGB(255,255,255)),
        tracer=self:createLine(Color3.fromRGB(255,255,255), 1),
        skeleton={}, headDot=self:createCircle(Color3.fromRGB(255,0,0), 1, true),
    }
end

function Visual:removePlayerESP(plr)
    local d = self.drawings[plr]; if not d then return end
    for _, obj in pairs(d) do
        if type(obj) == "table" then
            for _, sub in pairs(obj) do pcall(function() sub:Remove() end) end
        else pcall(function() obj:Remove() end) end
    end
    self.drawings[plr] = nil
end

function Visual:getBoundingBox(character)
    local cam = workspace.CurrentCamera
    local minX,minY,maxX,maxY = math.huge,math.huge,-math.huge,-math.huge
    local found = false
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            local pos, onScreen = cam:WorldToViewportPoint(part.Position)
            if onScreen then
                found = true
                local half = part.Size.Magnitude / 2
                minX=math.min(minX,pos.X-half); minY=math.min(minY,pos.Y-half)
                maxX=math.max(maxX,pos.X+half); maxY=math.max(maxY,pos.Y+half)
            end
        end
    end
    if not found then return nil end
    return {x=minX, y=minY, w=maxX-minX, h=maxY-minY}
end

function Visual:getTeamColor(plr)
    if not plr.Team then return Color3.fromRGB(255,255,255) end
    return plr.Team.TeamColor.Color
end

function Visual:updateESPBox(plr, data, bbox)
    if not self.settings.espBox or not bbox then data.box.Visible=false; return end
    data.box.Size = Vector2.new(bbox.w, bbox.h)
    data.box.Position = Vector2.new(bbox.x, bbox.y)
    data.box.Color = self.settings.espTeamColor and self:getTeamColor(plr) or Color3.fromRGB(255,255,255)
    data.box.Visible = true
end

function Visual:updateESPName(plr, data, bbox)
    if not self.settings.espName or not bbox then data.name.Visible=false; return end
    data.name.Text = plr.Name
    data.name.Position = Vector2.new(bbox.x + bbox.w/2 - data.name.TextBounds.X/2, bbox.y - 16)
    data.name.Color = self.settings.espTeamColor and self:getTeamColor(plr) or Color3.fromRGB(255,255,255)
    data.name.Visible = true
end

function Visual:updateESPHealth(plr, data, bbox)
    if not self.settings.espHealth or not bbox then data.health.Visible=false; return end
    local humanoid = plr.Character and plr.Character:FindFirstChild("Humanoid")
    if not humanoid then data.health.Visible=false; return end
    data.health.Text = math.floor(humanoid.Health) .. " HP"
    data.health.Position = Vector2.new(bbox.x + bbox.w + 4, bbox.y + bbox.h/2 - 6)
    data.health.Visible = true
end

function Visual:updateESPDistance(plr, data, bbox)
    if not self.settings.espDistance or not bbox then data.distance.Visible=false; return end
    local lp = game:GetService("Players").LocalPlayer
    if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return end
    if not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then return end
    local dist = math.floor((plr.Character.HumanoidRootPart.Position - lp.Character.HumanoidRootPart.Position).Magnitude)
    data.distance.Text = dist .. "m"
    data.distance.Position = Vector2.new(bbox.x + bbox.w/2 - data.distance.TextBounds.X/2, bbox.y + bbox.h + 2)
    data.distance.Visible = true
end

function Visual:updateESPTracer(plr, data, bbox)
    if not self.settings.espTracer or not bbox then data.tracer.Visible=false; return end
    local cam = workspace.CurrentCamera
    local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y)
    data.tracer.From = center
    data.tracer.To = Vector2.new(bbox.x + bbox.w/2, bbox.y + bbox.h)
    data.tracer.Color = self.settings.espTeamColor and self:getTeamColor(plr) or Color3.fromRGB(255,255,255)
    data.tracer.Visible = true
end

function Visual:updateESPSkeleton(plr, data)
    if not self.settings.espSkeleton then
        for _, line in ipairs(data.skeleton) do line.Visible=false end; return
    end
    local char = plr.Character; if not char then return end
    local bones = {
        {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
        {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},
        {"LeftLowerArm","LeftHand"},{"UpperTorso","RightUpperArm"},
        {"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
        {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},
        {"LeftLowerLeg","LeftFoot"},{"LowerTorso","RightUpperLeg"},
        {"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
    }
    local cam = workspace.CurrentCamera
    for i, pair in ipairs(bones) do
        if not data.skeleton[i] then data.skeleton[i] = self:createLine(Color3.fromRGB(255,255,255), 1) end
        local p1 = char:FindFirstChild(pair[1]); local p2 = char:FindFirstChild(pair[2])
        if p1 and p2 then
            local s1,o1 = cam:WorldToViewportPoint(p1.Position)
            local s2,o2 = cam:WorldToViewportPoint(p2.Position)
            if o1 and o2 then
                data.skeleton[i].From = Vector2.new(s1.X, s1.Y)
                data.skeleton[i].To = Vector2.new(s2.X, s2.Y)
                data.skeleton[i].Visible = true
            else data.skeleton[i].Visible = false end
        else data.skeleton[i].Visible = false end
    end
end

function Visual:updateHeadDot(plr, data)
    if not self.settings.headDot then data.headDot.Visible=false; return end
    local char = plr.Character; if not char then return end
    local head = char:FindFirstChild("Head"); if not head then return end
    local cam = workspace.CurrentCamera
    local pos, onScreen = cam:WorldToViewportPoint(head.Position)
    if onScreen then
        data.headDot.Position = Vector2.new(pos.X, pos.Y)
        data.headDot.Radius = self.settings.headDotSize
        data.headDot.Color = self.settings.headDotColor
        data.headDot.Visible = true
    else data.headDot.Visible = false end
end

function Visual:runESP()
    if not self.settings.esp then
        for _, data in pairs(self.drawings) do
            for _, obj in pairs(data) do
                if type(obj) == "userdata" then pcall(function() obj.Visible=false end) end
            end
        end
        return
    end
    local lp = game:GetService("Players").LocalPlayer
    for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
        if plr == lp then continue end
        if not plr.Character or not plr.Character:FindFirstChild("Humanoid") or plr.Character.Humanoid.Health <= 0 then
            self:removePlayerESP(plr); continue
        end
        local dist = 0
        if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("HumanoidRootPart") then
            dist = (plr.Character.HumanoidRootPart.Position - lp.Character.HumanoidRootPart.Position).Magnitude
        end
        if dist > self.settings.espMaxDistance then self:removePlayerESP(plr); continue end
        self:initPlayerESP(plr)
        local data = self.drawings[plr]
        local bbox = self:getBoundingBox(plr.Character)
        self:updateESPBox(plr, data, bbox)
        self:updateESPName(plr, data, bbox)
        self:updateESPHealth(plr, data, bbox)
        self:updateESPDistance(plr, data, bbox)
        self:updateESPTracer(plr, data, bbox)
        self:updateESPSkeleton(plr, data)
        self:updateHeadDot(plr, data)
    end
end

function Visual:createChams(plr)
    if self.highlights[plr] then return end
    local hl = Instance.new("Highlight")
    hl.Name = "void_chams"
    hl.Parent = plr.Character or workspace
    hl.Adornee = plr.Character
    self.highlights[plr] = hl
end

function Visual:updateChams(plr)
    if not self.settings.espChams then
        if self.highlights[plr] then self.highlights[plr]:Destroy(); self.highlights[plr]=nil end
        return
    end
    self:createChams(plr)
    local hl = self.highlights[plr]; if not hl then return end
    hl.FillColor = self.settings.chamsTeamColor and self:getTeamColor(plr) or self.settings.chamsColor
    hl.OutlineColor = self.settings.chamsOutlineColor
    hl.FillTransparency = self.settings.chamsTransparency
    hl.OutlineTransparency = self.settings.chamsOutline and 0 or 1
    if self.settings.chamsMode == "Fill" then hl.OutlineTransparency = 1
    elseif self.settings.chamsMode == "Wireframe" then hl.FillTransparency = 1 end
end

function Visual:runChams()
    for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
        if plr == game:GetService("Players").LocalPlayer then continue end
        if not plr.Character then
            if self.highlights[plr] then self.highlights[plr]:Destroy(); self.highlights[plr]=nil end
            continue
        end
        self:updateChams(plr)
    end
end

function Visual:runFullbright()
    if not self.settings.fullbright then return end
    local l = game:GetService("Lighting")
    l.Ambient = Color3.fromRGB(255,255,255)
    l.OutdoorAmbient = Color3.fromRGB(255,255,255)
    l.Brightness = 2
end
function Visual:runNoFog()
    if not self.settings.noFog then return end
    local l = game:GetService("Lighting"); l.FogEnd = 1e6; l.FogStart = 0
end
function Visual:runNoAmbient()
    if not self.settings.noAmbient then return end
    local l = game:GetService("Lighting")
    l.Ambient = self.settings.ambientColor; l.OutdoorAmbient = self.settings.outdoorAmbient
