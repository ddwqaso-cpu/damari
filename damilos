        self.fovZoneDrawing = self:createCircle(Color3.fromRGB(255, 0, 0), 1, false)
    end
    local cam = workspace.CurrentCamera
    self.fovZoneDrawing.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    self.fovZoneDrawing.Radius = self.settings.fovZoneRadius or 100
    self.fovZoneDrawing.Visible = true
end

-- 62. Показать направление движения цели (Velocity Vector)
function Visual:runVelocityVector()
    if not self.settings.velocityVector then return end
    if not self.velocityDrawings then self.velocityDrawings = {} end
    local cam = workspace.CurrentCamera
    for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
        if plr == game:GetService("Players").LocalPlayer then continue end
        if not plr.Character then continue end
        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local vel = hrp.AssemblyLinearVelocity
        if vel.Magnitude < 1 then
            if self.velocityDrawings[plr] then self.velocityDrawings[plr].Visible = false end
            continue
        end
        local startPos = hrp.Position
        local endPos = startPos + vel.Unit * 5
        if not self.velocityDrawings[plr] then
            self.velocityDrawings[plr] = self:createLine(Color3.fromRGB(0, 255, 255), 1)
        end
        local line = self.velocityDrawings[plr]
        local p1, o1 = cam:WorldToViewportPoint(startPos)
        local p2, o2 = cam:WorldToViewportPoint(endPos)
        if o1 and o2 then
            line.From = Vector2.new(p1.X, p1.Y)
            line.To = Vector2.new(p2.X, p2.Y)
            line.Visible = true
        else
            line.Visible = false
        end
    end
end

-- 63. Убрать туман воды (water fog)
function Visual:runNoWaterFog()
    local lighting = game:GetService("Lighting")
    local cc = lighting:FindFirstChild("void_water")
    if not cc then
        cc = Instance.new("ColorCorrectionEffect")
        cc.Name = "void_water"
        cc.Parent = lighting
    end
    cc.TintColor = Color3.fromRGB(255, 255, 255)
    cc.Saturation = 0
end

-- 64. Подсветка предметов (Highlight предметов на земле)
function Visual:runLootHighlight()
    if not self.settings.lootHighlight then return end
    if not self.lootHighlights then self.lootHighlights = {} end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name:lower():find("loot") or obj.Name:lower():find("drop")) then
            if not self.lootHighlights[obj] then
                local hl = Instance.new("Highlight")
                hl.FillColor = Color3.fromRGB(255, 255, 0)
                hl.OutlineColor = Color3.fromRGB(255, 255, 0)
                hl.FillTransparency = 0.5
                hl.Parent = obj
                self.lootHighlights[obj] = hl
            end
        end
    end
end

-- 65. Показать следы (Footprints)
function Visual:runFootprints()
    if not self.settings.footprints then return end
    if not self.footprintDrawings then self.footprintDrawings = {} end
    local cam = workspace.CurrentCamera
    for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
        if plr == game:GetService("Players").LocalPlayer then continue end
        if not plr.Character then continue end
        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local vel = hrp.AssemblyLinearVelocity
        if vel.Magnitude > 2 then
            if not self.footprintDrawings[plr] then
                self.footprintDrawings[plr] = {}
            end
            table.insert(self.footprintDrawings[plr], {pos = hrp.Position, time = tick()})
        end
        if self.footprintDrawings[plr] then
            for i = #self.footprintDrawings[plr], 1, -1 do
                local fp = self.footprintDrawings[plr][i]
                if tick() - fp.time > 3 then
                    table.remove(self.footprintDrawings[plr], i)
                end
            end
        end
    end
end

-- 66. Нарисовать круг вокруг игрока (Range Indicator)
function Visual:runRangeIndicator()
    if not self.settings.rangeIndicator then return end
    local lp = game:GetService("Players").LocalPlayer
    if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return end
    if not self.rangeDrawing then
        self.rangeDrawing = self:createCircle(Color3.fromRGB(255, 255, 0), 1, false)
    end
    local cam = workspace.CurrentCamera
    local hrp = lp.Character.HumanoidRootPart
    local pos = hrp.Position + Vector3.new(self.settings.rangeRadius or 20, 0, 0)
    local screenPos, onScreen = cam:WorldToViewportPoint(pos)
    local center, _ = cam:WorldToViewportPoint(hrp.Position)
    if onScreen then
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(center.X, center.Y)).Magnitude
        self.rangeDrawing.Position = Vector2.new(center.X, center.Y)
        self.rangeDrawing.Radius = dist
        self.rangeDrawing.Visible = true
    else
        self.rangeDrawing.Visible = false
    end
end

-- 67. Показать угол между камерой и целью (Angle Indicator)
function Visual:runAngleIndicator()
    if not self.settings.angleIndicator then return end
    if not self.angleDrawing then
        self.angleDrawing = self:createText(12, Color3.fromRGB(255, 200, 0))
    end
    local cam = workspace.CurrentCamera
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2 + 30)
    local bestAngle, bestPlr = math.huge, nil
    for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
        if plr == game:GetService("Players").LocalPlayer then continue end
        if not plr.Character then continue end
        local head = plr.Character:FindFirstChild("Head")
        if not head then continue end
        local toTarget = (head.Position - cam.CFrame.Position).Unit
        local angle = math.deg(math.acos(math.clamp(toTarget:Dot(cam.CFrame.LookVector), -1, 1)))
        if angle < bestAngle then bestAngle, bestPlr = angle, plr end
    end
    if bestPlr then
        self.angleDrawing.Text = string.format("Angle: %.1f° (%s)", bestAngle, bestPlr.Name)
        self.angleDrawing.Position = center
        self.angleDrawing.Visible = true
    else
        self.angleDrawing.Visible = false
    end
end

-- 68. Показать силу прыжка / скорость (Movement Info)
function Visual:runMovementInfo()
    if not self.settings.movementInfo then return end
    if not self.movementDrawing then
        self.movementDrawing = self:createText(13, Color3.fromRGB(150, 255, 150))
    end
    local lp = game:GetService("Players").LocalPlayer
    if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return end
    local vel = lp.Character.HumanoidRootPart.AssemblyLinearVelocity
    local speed = math.floor(Vector3.new(vel.X, 0, vel.Z).Magnitude)
    self.movementDrawing.Text = string.format("Speed: %d studs/s", speed)
    self.movementDrawing.Position = Vector2.new(10, 100)
    self.movementDrawing.Visible = true
end

-- 69. Показать состояние здоровья (Health Info)
function Visual:runHealthInfo()
    if not self.settings.healthInfo then return end
    if not self.healthInfoDrawing then
        self.healthInfoDrawing = self:createText(13, Color3.fromRGB(255, 100, 100))
    end
    local lp = game:GetService("Players").LocalPlayer
    if not lp.Character then return end
    local humanoid = lp.Character:FindFirstChild("Humanoid")
    if not humanoid then return end
    self.healthInfoDrawing.Text = string.format("HP: %d / %d", math.floor(humanoid.Health), math.floor(humanoid.MaxHealth))
    self.healthInfoDrawing.Position = Vector2.new(10, 120)
    self.healthInfoDrawing.Visible = true
end

