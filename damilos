-- Universal bind checker (supports KeyCode + UserInputType)
function K.IsBindDown(bind)
    if typeof(bind) == "EnumItem" and bind.EnumType == Enum.KeyCode then
        return UserInputService:IsKeyDown(bind)
    elseif typeof(bind) == "EnumItem" and bind.EnumType == Enum.UserInputType then
        return UserInputService:IsMouseButtonPressed(bind)
    end
    return false
end

function K.GetPlayers()
    local list = {}
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character 
           and player.Character:FindFirstChild("HumanoidRootPart") 
           and player.Character:FindFirstChild("Humanoid") 
           and player.Character.Humanoid.Health > 0 then
            table.insert(list, player)
        end
    end
    return list
end

function K.GetClosestPlayer(fov, partName)
    local closest = nil
    local shortestDist = fov
    for _, player in pairs(K.GetPlayers()) do
        local part = player.Character:FindFirstChild(partName or "HumanoidRootPart")
        if part then
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closest = player
                end
            end
        end
    end
    return closest
end

function K.GetClosestTarget(partName)
    local closest = nil
    local shortestDist = math.huge
    local myChar = LocalPlayer.Character
    if not myChar then return nil end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end
    for _, player in pairs(K.GetPlayers()) do
        local part = player.Character:FindFirstChild(partName or "HumanoidRootPart")
        if part then
            local dist = (part.Position - myHrp.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                closest = player
            end
        end
    end
    return closest
end

function K.GetPing()
    local ping = 0
    pcall(function()
        ping = math.floor(LocalPlayer:GetNetworkPing() * 1000)
    end)
    return ping
end

function K.CreateESP(player)
    if espCache[player] then return end
    local espData = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        Health = Drawing.new("Text"),
        Distance = Drawing.new("Text"),
        Tracer = Drawing.new("Line"),
        Chams = Instance.new("Highlight"),
        Conn = nil
    }
    espData.Box.Visible = false
    espData.Box.Thickness = 1
    espData.Box.Filled = false
    espData.Box.Color = Color3.fromRGB(255,255,255)
    espData.Name.Visible = false
    espData.Name.Size = 14
    espData.Name.Center = true
    espData.Name.Outline = true
    espData.Name.Color = Color3.fromRGB(255,255,255)
    espData.Health.Visible = false
    espData.Health.Size = 12
    espData.Health.Center = true
    espData.Health.Outline = true
    espData.Health.Color = Color3.fromRGB(0,255,0)
    espData.Distance.Visible = false
    espData.Distance.Size = 12
    espData.Distance.Center = true
    espData.Distance.Outline = true
    espData.Distance.Color = Color3.fromRGB(255,255,0)
    espData.Tracer.Visible = false
    espData.Tracer.Thickness = 1
    espData.Tracer.Color = Color3.fromRGB(255,0,0)
    espData.Chams.FillColor = Config.ESPChamsColor
    espData.Chams.OutlineColor = Config.ESPChamsColor
    espData.Chams.FillTransparency = Config.ESPChamsTransparency
    espData.Chams.OutlineTransparency = 1
    espData.Chams.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    espData.Chams.Parent = player.Character
    espCache[player] = espData

    espData.Conn = RunService.RenderStepped:Connect(function()
        if not Config.ESP or not player.Character 
           or not player.Character:FindFirstChild("HumanoidRootPart") 
           or not player.Character:FindFirstChild("Humanoid") 
           or player.Character.Humanoid.Health <= 0 then
            if espData.Box then espData.Box.Visible = false end
            if espData.Name then espData.Name.Visible = false end
            if espData.Health then espData.Health.Visible = false end
            if espData.Distance then espData.Distance.Visible = false end
            if espData.Tracer then espData.Tracer.Visible = false end
            if espData.Chams then espData.Chams.Enabled = false end
            return
        end
        local hrp = player.Character.HumanoidRootPart
        local hum = player.Character.Humanoid
        local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if onScreen then
            local sizeX = 2000 / pos.Z
            local sizeY = 3000 / pos.Z
            if Config.ESPBoxes then
                espData.Box.Size = Vector2.new(sizeX, sizeY)
                espData.Box.Position = Vector2.new(pos.X - sizeX/2, pos.Y - sizeY/2)
                espData.Box.Visible = true
                espData.Box.Color = Config.ESPChamsColor
            else espData.Box.Visible = false end
            if Config.ESPNames then
                espData.Name.Text = player.Name
                espData.Name.Position = Vector2.new(pos.X, pos.Y - sizeY/2 - 15)
                espData.Name.Visible = true
            else espData.Name.Visible = false end
            if Config.ESPHealth then
                espData.Health.Text = "HP: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)
                espData.Health.Position = Vector2.new(pos.X, pos.Y + sizeY/2 + 5)
                espData.Health.Visible = true
                espData.Health.Color = Color3.fromHSV(hum.Health/hum.MaxHealth * 0.3, 1, 1)
            else espData.Health.Visible = false end
            if Config.ESPDistance then
                local dist = (hrp.Position - Camera.CFrame.Position).Magnitude
                espData.Distance.Text = math.floor(dist) .. " studs"
                espData.Distance.Position = Vector2.new(pos.X, pos.Y + sizeY/2 + 20)
                espData.Distance.Visible = true
            else espData.Distance.Visible = false end
            if Config.ESPTracers then
                espData.Tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                espData.Tracer.To = Vector2.new(pos.X, pos.Y)
                espData.Tracer.Visible = true
                espData.Tracer.Color = Config.ESPChamsColor
            else espData.Tracer.Visible = false end
            if Config.ESPChams then espData.Chams.Enabled = true
            else espData.Chams.Enabled = false end
        else
            espData.Box.Visible = false
            espData.Name.Visible = false
            espData.Health.Visible = false
            espData.Distance.Visible = false
            espData.Tracer.Visible = false
            espData.Chams.Enabled = false
        end
    end)
end

function K.RemoveESP(player)
    if espCache[player] then
        for _, obj in pairs(espCache[player]) do
            if typeof(obj) == "Drawing" then obj:Remove()
            elseif typeof(obj) == "Instance" and obj.Destroy then obj:Destroy() end
        end
        if espCache[player].Conn then espCache[player].Conn:Disconnect() end
        espCache[player] = nil
    end
end

function K.UpdateESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and not espCache[player] then
            K.CreateESP(player)
        end
    end
end

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function()
        task.wait(1)
        if Config.ESP then K.CreateESP(p) end
    end)
end)

Players.PlayerRemoving:Connect(function(p)
    K.RemoveESP(p)
end)

