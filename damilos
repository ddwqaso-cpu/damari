-- =========================================================
-- ============== SILENT AIM LOGIC =========================
-- =========================================================

if hookmetamethod and getnamecallmethod then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if not Config.SilentAim then return oldNamecall(self, ...) end
        if method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" 
           or method == "FindPartOnRayWithWhitelist" or method == "Raycast" then
            local target = K.GetClosestPlayer(Config.SilentAimFOV, Config.SilentAimPart)
            if target and target.Character then
                local part = target.Character:FindFirstChild(Config.SilentAimPart)
                if part then
                    if method == "Raycast" then
                        args[2] = CFrame.new(Camera.CFrame.Position, part.Position).LookVector * 1000
                    else
                        args[1] = Ray.new(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position).Unit * 1000)
                    end
                    return oldNamecall(self, unpack(args))
                end
            end
        end
        return oldNamecall(self, ...)
    end)
end

