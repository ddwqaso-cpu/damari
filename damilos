local Misc = {}
Misc.__index = Misc

function Misc.new(env)
    local self = setmetatable({}, Misc)
    self.env = env or {}
    self.settings = {
        speedEnabled=false, speedValue=16, jumpEnabled=false, jumpValue=50,
        flyEnabled=false, flySpeed=50, flyKey=Enum.KeyCode.F, noclipEnabled=false,
        infiniteJump=false, teleportEnabled=false, antiAFK=false, autoRespawn=false,
        hideEnabled=false, chatSpam=false, chatMessage="", chatDelay=1,
        serverHop=false, reconnect=false, autoSaveConfig=false, configName="void_config",
    }
    self.connections = {}; self.flyConnection = nil; self.flyBV = nil
    return self
end

function Misc:getChar() return game:GetService("Players").LocalPlayer.Character end

function Misc:runSpeed()
    local char = self:getChar(); if not char then return end
    local h = char:FindFirstChild("Humanoid"); if not h then return end
    h.WalkSpeed = self.settings.speedEnabled and self.settings.speedValue or 16
end
function Misc:runJump()
    local char = self:getChar(); if not char then return end
    local h = char:FindFirstChild("Humanoid"); if not h then return end
    if self.settings.jumpEnabled then h.UseJumpPower = true; h.JumpPower = self.settings.jumpValue
    else h.JumpPower = 50 end
end
function Misc:startFly()
    local char = self:getChar(); if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    if self.flyBV then self.flyBV:Destroy() end
    local bv = Instance.new("BodyVelocity")
    bv.Name = "void_fly"; bv.MaxForce = Vector3.new(1e5,1e5,1e5); bv.Velocity = Vector3.zero
    bv.Parent = hrp; self.flyBV = bv
end
function Misc:runFly()
    if self.settings.flyEnabled then
        if not self.flyBV or not self.flyBV.Parent then self:startFly() end
        local cam = workspace.CurrentCamera; local move = Vector3.zero
        local uis = game:GetService("UserInputService")
        if uis:IsKeyDown(Enum.KeyCode.W) then move += cam.CFrame.LookVector end
        if uis:IsKeyDown(Enum.KeyCode.S) then move -= cam.CFrame.LookVector end
        if uis:IsKeyDown(Enum.KeyCode.A) then move -= cam.CFrame.RightVector end
        if uis:IsKeyDown(Enum.KeyCode.D) then move += cam.CFrame.RightVector end
        if uis:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0,1,0) end
        if uis:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.new(0,1,0) end
        if self.flyBV then self.flyBV.Velocity = move * self.settings.flySpeed end
    else
        if self.flyBV then self.flyBV:Destroy(); self.flyBV = nil end
    end
end
function Misc:runNoclip()
    if not self.settings.noclipEnabled then return end
    local char = self:getChar(); if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end
end
function Misc:runInfiniteJump()
    if not self.settings.infiniteJump then return end
    local uis = game:GetService("UserInputService")
    if uis:IsKeyDown(Enum.KeyCode.Space) then
        local char = self:getChar()
        if char then
            local h = char:FindFirstChild("Humanoid")
            if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end
end
function Misc:teleportToMouse()
    local char = self:getChar(); if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local mouse = game:GetService("Players").LocalPlayer:GetMouse()
    if mouse.Hit then hrp.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0,3,0)) end
end
function Misc:teleportToPlayer(targetName)
    local char = self:getChar(); if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local target = game:GetService("Players"):FindFirstChild(targetName)
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        hrp.CFrame = target.Character.HumanoidRootPart.CFrame
    end
end
function Misc:runAntiAFK()
    if not self.settings.antiAFK then return end
    local vu = game:GetService("VirtualUser")
    game:GetService("Players").LocalPlayer.Idled:Connect(function()
        vu:CaptureController(); vu:ClickButton2(Vector2.new())
    end)
end
function Misc:runAutoRespawn()
    if not self.settings.autoRespawn then return end
    local char = self:getChar()
    if char then
        local h = char:FindFirstChild("Humanoid")
        if h and h.Health <= 0 then game:GetService("Players").LocalPlayer:LoadCharacter() end
    end
end
function Misc:runHide()
    if not self.settings.hideEnabled then return end
    local char = self:getChar(); if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then part.Transparency = 1
        elseif part:IsA("Decal") then part.Transparency = 1 end
    end
end
function Misc:runChatSpam()
    if not self.settings.chatSpam then return end
    local chat = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
    if chat then
        local say = chat:FindFirstChild("SayMessageRequest")
        if say then say:FireServer(self.settings.chatMessage, "All") end
    end
    task.wait(self.settings.chatDelay)
end
function Misc:serverHop()
    local http = game:GetService("HttpService"); local placeId = game.PlaceId
    local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
    local ok, response = pcall(function() return http:JSONDecode(game:HttpGet(url)) end)
    if not ok or not response or not response.data then return end
    local currentJob = game.JobId
    for _, srv in ipairs(response.data) do
        if srv.id ~= currentJob and srv.playing < srv.maxPlayers then
            game:GetService("TeleportService"):TeleportToPlaceInstance(placeId, srv.id, game:GetService("Players").LocalPlayer)
            break
        end
    end
end
function Misc:reconnect()
    game:GetService("TeleportService"):Teleport(game.PlaceId, game:GetService("Players").LocalPlayer)
end
function Misc:saveConfig(data)
    local http = game:GetService("HttpService")
    local ok, encoded = pcall(function() return http:JSONEncode(data) end)
    if ok and writefile then writefile(self.settings.configName .. ".json", encoded) end
end
function Misc:loadConfig()
    if not isfile or not isfile(self.settings.configName .. ".json") then return nil end
    local content = readfile(self.settings.configName .. ".json")
    local http = game:GetService("HttpService")
    local ok, decoded = pcall(function() return http:JSONDecode(content) end)
    if not ok then return nil end
    return decoded
end
function Misc:runAutoSave()
    if not self.settings.autoSaveConfig then return end
    self:saveConfig(self.env.config or {})
end
function Misc:runAll()
    self:runSpeed(); self:runJump(); self:runFly(); self:runNoclip()
    self:runInfiniteJump(); self:runAntiAFK(); self:runAutoRespawn()
    self:runHide(); self:runChatSpam(); self:runAutoSave()
end

