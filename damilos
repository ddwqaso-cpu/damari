function Visual:drawWireframeBox(part, color)
    local corners = {}; local size = part.Size/2; local cframe = part.CFrame
    for x = -1, 1, 2 do for y = -1, 1, 2 do for z = -1, 1, 2 do
        table.insert(corners, cframe * Vector3.new(size.X*x, size.Y*y, size.Z*z))
    end end end
    local edges = {{1,2},{1,3},{1,5},{2,4},{2,6},{3,4},{3,7},{4,8},{5,6},{5,7},{6,8},{7,8}}
    local lines = {}
    for _, e in ipairs(edges) do
