-- 15. Обновить ESP Skeleton
function Visual:updateESPSkeleton(plr, data)
    if not self.settings.espSkeleton then
        for _, line in ipairs(data.skeleton) do line.Visible = false end
        return
    end
    local char = plr.Character
    if not char then return end
    local bones = {
        {"Head", "UpperTorso"},
        {"UpperTorso", "LowerTorso"},
        {"UpperTorso", "LeftUpperArm"},
        {"LeftUpperArm", "LeftLowerArm"},
        {"LeftLowerArm", "LeftHand"},
        {"UpperTorso", "RightUpperArm"},
        {"RightUpperArm", "RightLowerArm"},
        {"RightLowerArm", "RightHand"},
        {"LowerTorso", "LeftUpperLeg"},
        {"LeftUpperLeg", "LeftLowerLeg"},
        {"LeftLowerLeg", "LeftFoot"},
        {"LowerTorso", "RightUpperLeg"},
        {"RightUpperLeg", "RightLowerLeg"},
        {"RightLowerLeg", "RightFoot"},
    }
    local cam = workspace.CurrentCamera
    for i, pair in ipairs(bones) do
        if not data.skeleton[i] then
            data.skeleton[i] = self:createLine(Color3.fromRGB(255, 255, 255), 1)
        end
        local p1 = char:FindFirstChild(pair[1])
        local p2 = char:FindFirstChild(pair[2])
        if p1 and p2 then
            local s1, o1 = cam:WorldToViewportPoint(p1.Position)
            local s2, o2 = cam:WorldToViewportPoint(p2.Position)
            if o1 and o2 then
                data.skeleton[i].From = Vector2.new(s1.X, s1.Y)
                data.skeleton[i].To = Vector2.new(s2.X, s2.Y)
                data.skeleton[i].Visible = true
            else
                data.skeleton[i].Visible = false
            end
        else
            data.skeleton[i].Visible = false
        end
    end
end

