    lbl.Size = UDim2.new(1,-40,1,0)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = btn
    local sw = Instance.new("Frame")
    sw.Size = UDim2.new(0,18,0,18)
    sw.Position = UDim2.new(1,-24,0.5,-9)
    sw.BackgroundColor3 = default
    sw.Parent = btn
    Instance.new("UICorner", sw).CornerRadius = UDim.new(0,3)
    local h,s,v = default:ToHSV()
    local hueFrame = Instance.new("Frame")
    hueFrame.Size = UDim2.new(1,-6,0,40)
    hueFrame.BackgroundColor3 = Color3.fromRGB(30,30,38)
    hueFrame.Visible = false
    hueFrame.Parent = parent
    Instance.new("UICorner", hueFrame).CornerRadius = UDim.new(0,3)
    local hueBar = Instance.new("Frame")
    hueBar.Size = UDim2.new(1,-12,0,10)
    hueBar.Position = UDim2.new(0,6,0,6)
    hueBar.BackgroundColor3 = Color3.fromRGB(60,60,70)
    hueBar.Parent = hueFrame
    Instance.new("UICorner", hueBar).CornerRadius = UDim.new(0,2)
    local hueFill = Instance.new("Frame")
    hueFill.Size = UDim2.new(h,0,1,0)
    hueFill.BackgroundColor3 = Color3.fromRGB(160,80,255)
    hueFill.Parent = hueBar
    local satBar = Instance.new("Frame")
    satBar.Size = UDim2.new(1,-12,0,10)
    satBar.Position = UDim2.new(0,6,0,22)
    satBar.BackgroundColor3 = Color3.fromRGB(60,60,70)
    satBar.Parent = hueFrame
    Instance.new("UICorner", satBar).CornerRadius = UDim.new(0,2)
    local satFill = Instance.new("Frame")
    satFill.Size = UDim2.new(s,0,1,0)
    satFill.BackgroundColor3 = Color3.fromRGB(160,80,255)
    satFill.Parent = satBar
    local function update()
        local c = Color3.fromHSV(h,s,v)
        sw.BackgroundColor3 = c
        callback(c)
    end
    local dH, dS = false, false
    hueBar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dH=true end end)
    satBar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dS=true end end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dH=false; dS=false end end)
    UIS.InputChanged:Connect(function(i)
        if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        if dH then
            h = math.clamp((i.Position.X - hueBar.AbsolutePosition.X)/hueBar.AbsoluteSize.X,0,1)
            hueFill.Size = UDim2.new(h,0,1,0); update()
        elseif dS then
            s = math.clamp((i.Position.X - satBar.AbsolutePosition.X)/satBar.AbsoluteSize.X,0,1)
            satFill.Size = UDim2.new(s,0,1,0); update()
        end
    end)
    btn.MouseButton1Click:Connect(function() hueFrame.Visible = not hueFrame.Visible end)
end

