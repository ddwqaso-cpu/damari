-- 50. Нарисовать 3D-куб (wireframe) вокруг объекта
function Visual:drawWireframeBox(part, color)
    local corners = {}
    local size = part.Size / 2
    local cframe = part.CFrame
    for x = -1, 1, 2 do
        for y = -1, 1, 2 do
            for z = -1, 1, 2 do
                table.insert(corners, cframe * Vector3.new(size.X * x, size.Y * y, size.Z * z))
            end
        end
    end
    local edges = {
        {1,2},{1,3},{1,5},{2,4},{2,6},{3,4},{3,7},{4,8},{5,6},{5,7},{6,8},{7,8}
    }
    local lines = {}
    for _, e in ipairs(edges) do
        local l = self:drawWorldLine(corners[e[1]], corners[e[2]], color, 1)
        if l then table.insert(lines, l) end
    end
    return lines
end

