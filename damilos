function P.IsBindDown(bind)
    if typeof(bind) == "EnumItem" and bind.EnumType == Enum.KeyCode then
        return UserInputService:IsKeyDown(bind)
    elseif typeof(bind) == "EnumItem" and bind.EnumType == Enum.UserInputType then
        return UserInputService:IsMouseButtonPressed(bind)
    end
    return false
end

