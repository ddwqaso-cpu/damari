-- CHAMS (Highlight / Fill / Outline)
local chamsCache={}
local function removeChams(char)
if chamsCache[char]then
if chamsCache[char].hl then pcall(function()chamsCache[char].hl:Destroy()end)end
if chamsCache[char].parts then
for _,p in ipairs(chamsCache[char].parts)do
if p.Parent then p.Color=chamsCache[char].origColor[p]or p.Color end end end
chamsCache[char]=nil end end

