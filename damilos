-- 17. Основной цикл ESP
function Visual:runESP()
    if not self.settings.esp then
        for _, data in pairs(self.drawings) do
            for _, obj in pairs(data) do
                if type(obj) == "userdata" then pcall(function() obj.Visible = false end) end
            end
        end
        return
    end
    local lp = game:GetService("Players").LocalPlayer
    local cam = workspace.CurrentCamera
    for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
        if plr == lp then continue end
        if not plr.Character or not plr.Character:FindFirstChild("Humanoid") then
            self:removePlayerESP(plr)
            continue
        end
        if plr.Character.Humanoid.Health <= 0 then
            self:removePlayerESP(plr)
            continue
        end
        local dist = 0
        if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("HumanoidRootPart") then
            dist = (plr.Character.HumanoidRootPart.Position - lp.Character.HumanoidRootPart.Position).Magnitude
        end
        if dist > self.settings.espMaxDistance then
            self:removePlayerESP(plr)
            continue
        end
        self:initPlayerESP(plr)
        local data = self.drawings[plr]
        local bbox = self:getBoundingBox(plr.Character)
        self:updateESPBox(plr, data, bbox)
        self:updateESPName(plr, data, bbox)
        self:updateESPHealth(plr, data, bbox)
        self:updateESPDistance(plr, data, bbox)
        self:updateESPTracer(plr, data, bbox)
        self:updateESPSkeleton(plr, data)
        self:updateHeadDot(plr, data)
    end
