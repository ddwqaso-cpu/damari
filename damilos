        espMaxDistance=1000, chamsMode="Fill", chamsColor=Color3.fromRGB(255,0,0),
        chamsTransparency=0.5, chamsTeamColor=true, chamsOutline=true,
        chamsOutlineColor=Color3.fromRGB(0,255,0), fullbright=false, noFog=false,
        noAmbient=false, noSky=false, skyboxColor=Color3.fromRGB(0,0,0),
        ambientColor=Color3.fromRGB(255,255,255), outdoorAmbient=Color3.fromRGB(255,255,255),
        fovChanger=false, fovValue=90, cameraDistance=12.5, crosshair=false,
        crosshairColor=Color3.fromRGB(0,255,0), crosshairSize=10, crosshairThickness=2,
        fovCircle=false, fovCircleColor=Color3.fromRGB(255,255,255), fovCircleRadius=120,
        headDot=false, headDotColor=Color3.fromRGB(255,0,0), headDotSize=6,
        viewmodelChanger=false, viewmodelOffset=Vector3.zero, worldTint=false,
        worldTintColor=Color3.fromRGB(255,255,255), nightVision=false, thermalVision=false,
        xray=false, wireframeWorld=false, removeTextures=false, removeDecals=false,
        removeParticles=false, removeShadows=false, removeWater=false, removeGrass=false,
        customSkybox=false, sunColor=Color3.fromRGB(255,255,255), clockTime=12,
        fogEnd=1000, fogStart=0, fogColor=Color3.fromRGB(192,192,192),
        bloom=false, bloomIntensity=1, bloomSize=24, blur=false, blurSize=24,
        colorCorrection=false, saturation=0, contrast=0, brightness=0,
        dof=false, dofFocus=0.05, dofFar=0.1, dofNear=0.05,
        itemESP=false, healthbarESP=false, weaponESP=false, viewDirectionESP=false,
        hud=false, nearbyList=false, aimLine=false, screenOverlay=false,
        fovZone=false, velocityVector=false, lootHighlight=false, footprints=false,
