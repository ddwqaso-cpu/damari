-- 6. Удалить ESP для игрока
function Visual:removePlayerESP(plr)
    local d = self.drawings[plr]; if not d then return end
    for _, obj in pairs(d) do
        if type(obj) == "table" then
            for _, sub in pairs(obj) do pcall(function() sub:Remove() end) end
        else pcall(function() obj:Remove() end) end
    end
    self.drawings[plr] = nil
end

-- 7. Получить 2D Bounding Box
function Visual:getBoundingBox(character)
    local cam = workspace.CurrentCamera
    local minX,minY,maxX,maxY = math.huge,math.huge,-math.huge,-math.huge
    local found = false
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            local pos, onScreen = cam:WorldToViewportPoint(part.Position)
            if onScreen then
                found = true
                local half = part.Size.Magnitude / 2
                minX=math.min(minX,pos.X-half); minY=math.min(minY,pos.Y-half)
                maxX=math.max(maxX,pos.X+half); maxY=math.max(maxY,pos.Y+half)
            end
        end
    end
    if not found then return nil end
    return {x=minX, y=minY, w=maxX-minX, h=maxY-minY}
end

