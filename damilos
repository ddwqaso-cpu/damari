if hookmetamethod and getnamecallmethod and not P.silentAimHooked then
    P.silentAimHooked = true
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if Config.SilentAim and (method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList"
           or method == "FindPartOnRayWithWhitelist" or method == "Raycast") then
            if math.random(1, 100) <= Config.SilentAimHitChance then
                local target = P.GetClosestPlayer(Config.SilentAimFOV, Config.SilentAimPart)
                if target and target.Character then
                    local part = target.Character:FindFirstChild(Config.SilentAimPart)
                    if part then
                        if method == "Raycast" then
                            args[2] = CFrame.new(Camera.CFrame.Position, part.Position).LookVector * 1000
                        else
                            args[1] = Ray.new(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position).Unit * 1000)
                        end
                        return oldNamecall(self, unpack(args))
                    end
                end
            end
        end
        return oldNamecall(self, ...)
    end)
end

