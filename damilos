local env = { config = {} }

local combat = Combat.new(env)
local visual = Visual.new(env)
local misc = Misc.new(env)

-- Применяем настройки из части 3 (Visual 36-70) к visual
for k, v in pairs(Visual2.new(env).settings) do
    if visual.settings[k] == nil then visual.settings[k] = v end
end

env.combat = combat
env.visual = visual
env.misc = misc

-- ============================================================
-- Главный цикл (RenderStepped)
-- ============================================================
local RunService = game:GetService("RunService")

local renderConn = RunService.RenderStepped:Connect(function()
    -- Combat
    pcall(function() combat:runAimbot() end)
    pcall(function() combat:runSilentAim() end)
    pcall(function() combat:runTriggerBot() end)
    pcall(function() combat:runHitboxExpander() end)
    pcall(function() combat:runNoRecoil() end)
    pcall(function() combat:runNoSpread() end)
    pcall(function() combat:runFastReload() end)
    pcall(function() combat:runInfiniteAmmo() end)
    pcall(function() combat:runAutoFire() end)
    pcall(function() combat:runMeleeAura() end)
    pcall(function() combat:runKillAura() end)
    pcall(function() combat:runAntiFling() end)
    pcall(function() combat:runAntiRagdoll() end)
    pcall(function() combat:runAntiVoid() end)
    pcall(function() combat:runAutoParry() end)

    -- Visual
    pcall(function() visual:runAll() end)

    -- Misc
    pcall(function() misc:runAll() end)
end)

-- ============================================================
-- Бинды (пример: toggle aimbot на RightShift, fly на F)
-- ============================================================
local UIS = game:GetService("UserInputService")

UIS.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        combat.settings.aimbot = not combat.settings.aimbot
    elseif input.KeyCode == Enum.KeyCode.F then
        misc.settings.flyEnabled = not misc.settings.flyEnabled
    elseif input.KeyCode == Enum.KeyCode.X then
        combat.settings.killAura = not combat.settings.killAura
    elseif input.KeyCode == Enum.KeyCode.V then
        visual.settings.esp = not visual.settings.esp
    elseif input.KeyCode == Enum.KeyCode.C then
        visual.settings.espChams = not visual.settings.espChams
    end
end)

-- ============================================================
-- Очистка
-- ============================================================
function env.destroy()
    if renderConn then renderConn:Disconnect() end
    for _, d in pairs(visual.drawings) do
        for _, obj in pairs(d) do
            if type(obj) == "userdata" then pcall(function() obj:Remove() end) end
        end
    end
    for _, hl in pairs(visual.highlights) do pcall(function() hl:Destroy() end) end
end

return env
