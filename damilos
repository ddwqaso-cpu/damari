function K.CreateBind(parent, name, default, callback, flag)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 25)
    frame.BackgroundTransparency = 1
    frame.Parent = parent
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 14
    label.Font = Enum.Font.SourceSans
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame
    local bindBtn = Instance.new("TextButton")
    bindBtn.Size = UDim2.new(0, 60, 0, 20)
    bindBtn.Position = UDim2.new(1, -60, 0, 2)
    bindBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    bindBtn.Text = default.Name
    bindBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    bindBtn.TextSize = 12
    bindBtn.Parent = frame
    local isBinding = false
    bindBtn.MouseButton1Click:Connect(function()
        isBinding = true
        bindBtn.Text = "..."
    end)
    UserInputService.InputBegan:Connect(function(input, gp)
        if isBinding and not gp then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                bindBtn.Text = input.KeyCode.Name
                Config[flag] = input.KeyCode
                isBinding = false
                callback(input.KeyCode)
            elseif input.UserInputType == Enum.UserInputType.MouseButton1 
                or input.UserInputType == Enum.UserInputType.MouseButton2 then
                bindBtn.Text = input.UserInputType.Name
                Config[flag] = input.UserInputType
                isBinding = false
                callback(input.UserInputType)
            end
        end
    end)
    return frame
end

function K.CreateTextbox(parent, name, default, callback, flag)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 25)
    frame.BackgroundTransparency = 1
    frame.Parent = parent
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.5, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 14
    label.Font = Enum.Font.SourceSans
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.5, -5, 1, 0)
    box.Position = UDim2.new(0.5, 0, 0, 0)
    box.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.TextSize = 12
    box.Text = default
    box.Font = Enum.Font.SourceSans
    box.Parent = frame
    box.FocusLost:Connect(function()
        Config[flag] = box.Text
        callback(box.Text)
    end)
    return frame
end

