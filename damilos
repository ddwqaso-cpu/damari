local function addSlider(parent, label, min, max, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1,-6,0,36)
    frame.BackgroundColor3 = Color3.fromRGB(26,26,34)
    frame.Parent = parent
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0,3)
    local lbl = Instance.new("TextLabel")
    lbl.Text = label
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.TextColor3 = Color3.fromRGB(220,220,230)
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0,6,0,2)
    lbl.Size = UDim2.new(1,-60,0,14)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = frame
    local valLbl = Instance.new("TextLabel")
    valLbl.Text = tostring(default)
    valLbl.Font = Enum.Font.Gotham
    valLbl.TextSize = 12
    valLbl.TextColor3 = Color3.fromRGB(180,100,255)
    valLbl.BackgroundTransparency = 1
    valLbl.Position = UDim2.new(1,-50,0,2)
    valLbl.Size = UDim2.new(0,44,0,14)
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.Parent = frame
    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1,-12,0,6)
    bar.Position = UDim2.new(0,6,0,22)
    bar.BackgroundColor3 = Color3.fromRGB(40,40,50)
    bar.Parent = frame
    Instance.new("UICorner", bar).CornerRadius = UDim.new(0,3)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default-min)/(max-min),0,1,0)
    fill.BackgroundColor3 = Color3.fromRGB(160,80,255)
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0,3)
    local dragging = false
    bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    UIS.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            local rel = math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + (max-min)*rel + 0.5)
            fill.Size = UDim2.new(rel,0,1,0)
            valLbl.Text = tostring(val)
            callback(val)
        end
    end)
end

