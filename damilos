-- ============================================================
-- COMBAT (30)
-- ============================================================
local Combat = {}
Combat.__index = Combat

function Combat.new(env)
    local self = setmetatable({}, Combat)
    self.env = env or {}
    self.settings = {
        aimbot=false, aimKey=Enum.KeyCode.E, aimSmoothness=0.35, aimPart="Head",
        aimFOV=120, aimVisibleCheck=true, aimPrediction=0.165, silentAim=false,
        triggerBot=false, triggerDelay=0.05, triggerFOV=8, hitboxExpander=false,
        hitboxSize=8, noRecoil=false, noSpread=false, fastReload=false,
        infiniteAmmo=false, autoFire=false, fireRate=0.1, meleeAura=false,
        meleeRange=12, killAura=false, killAuraRange=18, killAuraMode="Distance",
        killAuraDelay=0.12, antiFling=false, antiRagdoll=false, antiVoid=false,
        autoParry=false, parryWindow=0.2, projectileAim=false, projectileSpeed=250,
        wallCheck=true, teamCheck=true, friendCheck=true,
    }
    self.friends = {}
    self.connections = {}
    return self
end

function Combat:getLocalPlayer() return game:GetService("Players").LocalPlayer end
function Combat:getCamera() return workspace.CurrentCamera end

function Combat:getAlivePlayers()
    local list = {}
    for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
        if plr ~= self:getLocalPlayer() and plr.Character and plr.Character:FindFirstChild("Humanoid") then
            if plr.Character.Humanoid.Health > 0 then table.insert(list, plr) end
        end
    end
    return list
end

function Combat:isFriend(plr) return self.friends[plr.Name] == true or self.friends[plr.UserId] == true end

function Combat:isTeammate(plr)
    if not self.settings.teamCheck then return false end
    local lp = self:getLocalPlayer()
    if not lp.Team or not plr.Team then return false end
    return lp.Team == plr.Team
end

function Combat:isVisible(character, part)
    if not self.settings.aimVisibleCheck then return true end
    local cam = self:getCamera()
    local origin = cam.CFrame.Position
    local target = part.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {self:getLocalPlayer().Character, cam}
    local result = workspace:Raycast(origin, target - origin, params)
    return result == nil or result.Instance:IsDescendantOf(character)
end

function Combat:getTargetPart(character)
    local part = character:FindFirstChild(self.settings.aimPart)
    if part then return part end
    return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
end

function Combat:getScreenDistance(worldPos)
    local cam = self:getCamera()
    local screenPos, onScreen = cam:WorldToViewportPoint(worldPos)
    if not onScreen then return math.huge end
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    return (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
end

function Combat:getClosestByFOV()
    local best, bestDist = nil, self.settings.aimFOV
    for _, plr in ipairs(self:getAlivePlayers()) do
        if self:isFriend(plr) or self:isTeammate(plr) then continue end
        local part = self:getTargetPart(plr.Character)
        if part and self:isVisible(plr.Character, part) then
            local d = self:getScreenDistance(part.Position)
            if d < bestDist then best, bestDist = plr, d end
        end
    end
    return best
end

function Combat:getClosestByDistance()
    local lp = self:getLocalPlayer()
    if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = lp.Character.HumanoidRootPart.Position
    local best, bestDist = nil, math.huge
    for _, plr in ipairs(self:getAlivePlayers()) do
        if self:isFriend(plr) or self:isTeammate(plr) then continue end
        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local d = (hrp.Position - myPos).Magnitude
            if d < bestDist then best, bestDist = plr, d end
        end
    end
    return best
end

function Combat:predictPosition(part, projectileSpeed)
    local velocity = part.AssemblyLinearVelocity or Vector3.zero
    local dist = (part.Position - self:getCamera().CFrame.Position).Magnitude
    local t = dist / (projectileSpeed or self.settings.projectileSpeed)
    return part.Position + velocity * t
end

function Combat:smoothAim(targetPos, smoothness)
    local cam = self:getCamera()
    local current = cam.CFrame
    local desired = CFrame.new(current.Position, targetPos)
    cam.CFrame = current:Lerp(desired, smoothness or self.settings.aimSmoothness)
end

function Combat:snapAim(targetPos)
    local cam = self:getCamera()
    cam.CFrame = CFrame.new(cam.CFrame.Position, targetPos)
end

function Combat:runAimbot()
    if not self.settings.aimbot then return end
    local target = self:getClosestByFOV()
    if not target then return end
    local part = self:getTargetPart(target.Character)
    if not part then return end
    local pos = part.Position
    if self.settings.projectileAim then pos = self:predictPosition(part) end
    self:smoothAim(pos)
end

function Combat:runSilentAim()
    if not self.settings.silentAim then return end
    local target = self:getClosestByFOV()
    if not target then return end
    local part = self:getTargetPart(target.Character)
    if not part then return end
    local cam = self:getCamera()
    local old = cam.CFrame
    cam.CFrame = CFrame.new(old.Position, part.Position)
    task.defer(function() cam.CFrame = old end)
end

function Combat:fireWeapon()
    local vim = game:GetService("VirtualInputManager")
    vim:SendMouseButtonEvent(0, 0, 0, true, game, 1)
    task.wait(0.01)
    vim:SendMouseButtonEvent(0, 0, 0, false, game, 1)
end

function Combat:runTriggerBot()
    if not self.settings.triggerBot then return end
    local cam = self:getCamera()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {self:getLocalPlayer().Character}
    local result = workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * 500, params)
    if result and result.Instance:FindFirstAncestorOfClass("Model") then
        local model = result.Instance:FindFirstAncestorOfClass("Model")
        local plr = game:GetService("Players"):GetPlayerFromCharacter(model)
        if plr and not self:isFriend(plr) and not self:isTeammate(plr) then
            task.wait(self.settings.triggerDelay)
            self:fireWeapon()
        end
    end
end

function Combat:runHitboxExpander()
    if not self.settings.hitboxExpander then return end
    for _, plr in ipairs(self:getAlivePlayers()) do
        if self:isFriend(plr) then continue end
        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Size = Vector3.new(self.settings.hitboxSize, self.settings.hitboxSize, self.settings.hitboxSize)
            hrp.Transparency = 0.7
            hrp.CanCollide = false
        end
    end
end

function Combat:runNoRecoil()
    if not self.settings.noRecoil then return end
    local cam = self:getCamera()
    cam.CFrame = CFrame.new(cam.CFrame.Position, cam.CFrame.Position + cam.CFrame.LookVector)
end

function Combat:runNoSpread()
    if not self.settings.noSpread then return end
    local char = self:getLocalPlayer().Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then pcall(function() tool.Spread = 0 end) end
end

function Combat:runFastReload()
    if not self.settings.fastReload then return end
    local char = self:getLocalPlayer().Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then pcall(function() tool.ReloadTime = 0 end) end
end

function Combat:runInfiniteAmmo()
    if not self.settings.infiniteAmmo then return end
    local char = self:getLocalPlayer().Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then pcall(function() tool.Ammo = 9999 end) end
end

function Combat:runAutoFire()
    if not self.settings.autoFire then return end
    self:fireWeapon()
    task.wait(self.settings.fireRate)
end

function Combat:runMeleeAura()
    if not self.settings.meleeAura then return end
    local lp = self:getLocalPlayer()
    if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return end
    local myPos = lp.Character.HumanoidRootPart.Position
    for _, plr in ipairs(self:getAlivePlayers()) do
        if self:isFriend(plr) or self:isTeammate(plr) then continue end
        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        if hrp and (hrp.Position - myPos).Magnitude <= self.settings.meleeRange then
            self:fireWeapon(); break
        end
    end
end

function Combat:runKillAura()
    if not self.settings.killAura then return end
    local lp = self:getLocalPlayer()
    if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return end
    local myPos = lp.Character.HumanoidRootPart.Position
    local targets = {}
    for _, plr in ipairs(self:getAlivePlayers()) do
        if self:isFriend(plr) or self:isTeammate(plr) then continue end
        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        if hrp and (hrp.Position - myPos).Magnitude <= self.settings.killAuraRange then
            table.insert(targets, {plr = plr, dist = (hrp.Position - myPos).Magnitude})
        end
    end
    if self.settings.killAuraMode == "Distance" then
        table.sort(targets, function(a, b) return a.dist < b.dist end)
    end
    for _, t in ipairs(targets) do
        local part = self:getTargetPart(t.plr.Character)
        if part then
            self:snapAim(part.Position)
            self:fireWeapon()
            task.wait(self.settings.killAuraDelay)
        end
    end
end

function Combat:runAntiFling()
    if not self.settings.antiFling then return end
    local char = self:getLocalPlayer().Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0) end
end

function Combat:runAntiRagdoll()
    if not self.settings.antiRagdoll then return end
    local char = self:getLocalPlayer().Character
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid")
    if humanoid then
        humanoid.PlatformStand = false
        humanoid.Sit = false
        humanoid:ChangeState(Enum.HumanoidStateType.Running)
    end
end

function Combat:runAntiVoid()
    if not self.settings.antiVoid then return end
    local char = self:getLocalPlayer().Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and hrp.Position.Y < -50 then hrp.CFrame = CFrame.new(0, 50, 0) end
end

function Combat:runAutoParry()
    if not self.settings.autoParry then return end
    local lp = self:getLocalPlayer()
    if not lp.Character then return end
    for _, plr in ipairs(self:getAlivePlayers()) do
        if self:isFriend(plr) or self:isTeammate(plr) then continue end
        local tool = plr.Character:FindFirstChildOfClass("Tool")
        if tool and tool:GetAttribute("Attacking") then
            local humanoid = lp.Character:FindFirstChild("Humanoid")
            if humanoid then
                humanoid:ChangeState(Enum.HumanoidStateType.Physics)
                task.wait(self.settings.parryWindow)
            end
        end
    end
end

-- ============================================================
