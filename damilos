page.Visible=false page.ZIndex=2 page.Parent=content
pages[name]=page buttons[name]=btn btn.MouseButton1Click:Connect(function()
for n,p in pairs(pages)do p.Visible=(n==name)
buttons[n].TextColor3=(n==name)and COL.accent or COL.textDim end end)
return page end
