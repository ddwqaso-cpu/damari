local function makeDraw(key,type)
if not espDrawings[key]then espDrawings[key]={}end
if not espDrawings[key][type]then
local d=Drawing.new(type)
if type=="Text"then d.Size=13 d.Center=true d.Outline=true
elseif type=="Square"then d.Thickness=1 d.Filled=false
elseif type=="Line"then d.Thickness=1
elseif type=="Circle"then d.Thickness=2 d.Filled=true d.NumSides=12
elseif type=="Triangle"then d.Thickness=1 d.Filled=true end
espDrawings[key][type]=d end
return espDrawings[key][type]end

