local function getChar(plr)
plr=plr or lp
return plr.Character, plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
end

local function isValidTarget(plr)
if plr==lp then return false end
local char=plr.Character
if not char then return false end
local hum=char:FindFirstChildOfClass("Humanoid")
if not hum or hum.Health<=0 then return false end
if C.SA_TeamCheck or C.AB_TeamCheck or C.ESP_TeamCheck then
if plr.Team and lp.Team and plr.Team==lp.Team then return false end end
return true,char,hum
end

