-- 7. Удалить ESP для игрока
function Visual:removePlayerESP(plr)
    local d = self.drawings[plr]
    if not d then return end
    for _, obj in pairs(d) do
        if typeof(obj) == "Instance" or typeof(obj) == "userdata" then
            pcall(function() obj:Remove() end)
        elseif type(obj) == "table" then
            for _, sub in pairs(obj) do
                pcall(function() sub:Remove() end)
            end
        end
    end
    self.drawings[plr] = nil
end

-- 8. Получить 2D bounding box персонажа
function Visual:getBoundingBox(character)
    local cam = workspace.CurrentCamera
    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local found = false
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            local pos, onScreen = cam:WorldToViewportPoint(part.Position)
            if onScreen then
                found = true
                local size = part.Size.Magnitude
                local half = size / 2
                minX = math.min(minX, pos.X - half)
                minY = math.min(minY, pos.Y - half)
                maxX = math.max(maxX, pos.X + half)
                maxY = math.max(maxY, pos.Y + half)
            end
        end
    end
    if not found then return nil end
    return {x = minX, y = minY, w = maxX - minX, h = maxY - minY}
end

