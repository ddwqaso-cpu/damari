-- 5. Основной цикл (вызывает ВСЕ 120 функций каждый кадр)
local RunService = game:GetService("RunService")
RunService.RenderStepped:Connect(function()
    pcall(function() combat:runAimbot() end)
    pcall(function() combat:runSilentAim() end)
    pcall(function() combat:runTriggerBot() end)
    pcall(function() combat:runHitboxExpander() end)
    pcall(function() combat:runNoRecoil() end)
    pcall(function() combat:runNoSpread() end)
    pcall(function() combat:runFastReload() end)
    pcall(function() combat:runInfiniteAmmo() end)
    pcall(function() combat:runAutoFire() end)
    pcall(function() combat:runMeleeAura() end)
    pcall(function() combat:runKillAura() end)
    pcall(function() combat:runAntiFling() end)
    pcall(function() combat:runAntiRagdoll() end)
    pcall(function() combat:runAntiVoid() end)
    pcall(function() combat:runAutoParry() end)

    pcall(function() visual:runAll() end)
    pcall(function() misc:runAll() end)
end)

-- 6. Бинды (Горячие клавиши)
local UIS = game:GetService("UserInputService")
UIS.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.RightShift then combat.settings.aimbot = not combat.settings.aimbot; Rayfield:Notify({Title = "Aimbot", Content = combat.settings.aimbot and "Включен" or "Выключен", Duration = 2})
    elseif input.KeyCode == Enum.KeyCode.F then misc.settings.flyEnabled = not misc.settings.flyEnabled; Rayfield:Notify({Title = "Fly", Content = misc.settings.flyEnabled and "Включен" or "Выключен", Duration = 2})
    elseif input.KeyCode == Enum.KeyCode.X then combat.settings.killAura = not combat.settings.killAura; Rayfield:Notify({Title = "Kill Aura", Content = combat.settings.killAura and "Включена" or "Выключена", Duration = 2})
    elseif input.KeyCode == Enum.KeyCode.V then visual.settings.esp = not visual.settings.esp; Rayfield:Notify({Title = "ESP", Content = visual.settings.esp and "Включен" or "Выключен", Duration = 2})
    elseif input.KeyCode == Enum.KeyCode.C then visual.settings.espChams = not visual.settings.espChams; Rayfield:Notify({Title = "Chams", Content = visual.settings.espChams and "Включены" or "Выключены", Duration = 2})
    elseif input.KeyCode == Enum.KeyCode.G then misc.settings.noclipEnabled = not misc.settings.noclipEnabled; Rayfield:Notify({Title = "Noclip", Content = misc.settings.noclipEnabled and "Включен" or "Выключен", Duration = 2})
    end
end)

