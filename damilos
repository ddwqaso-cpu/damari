    local center = cam:WorldToViewportPoint(hrp.Position)
    if onScreen then
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(center.X, center.Y)).Magnitude
        self.rangeDrawing.Position = Vector2.new(center.X, center.Y); self.rangeDrawing.Radius = dist; self.rangeDrawing.Visible = true
    else self.rangeDrawing.Visible = false end
end

-- 66. Angle Indicator
function Visual:runAngleIndicator()
    if not self.settings.angleIndicator then return end
    if not self.angleDrawing then self.angleDrawing = DrawingAPI.new("Text"); self.angleDrawing.Size=12; self.angleDrawing.Color=Color3.fromRGB(255,200,0); self.angleDrawing.Outline=true end
    local cam = workspace.CurrentCamera
    local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2 + 30)
    local bestAngle, bestPlr = math.huge, nil
    for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
        if plr == game:GetService("Players").LocalPlayer then continue end
        if not plr.Character then continue end
        local head = plr.Character:FindFirstChild("Head"); if not head then continue end
        local toTarget = (head.Position - cam.CFrame.Position).Unit
        local angle = math.deg(math.acos(math.clamp(toTarget:Dot(cam.CFrame.LookVector), -1, 1)))
        if angle < bestAngle then bestAngle, bestPlr = angle, plr end
    end
    if bestPlr then
        self.angleDrawing.Text = string.format("Angle: %.1f° (%s)", bestAngle, bestPlr.Name)
        self.angleDrawing.Position = center; self.angleDrawing.Visible = true
    else self.angleDrawing.Visible = false end
end

-- 67. Movement Info
function Visual:runMovementInfo()
    if not self.settings.movementInfo then return end
    if not self.movementDrawing then self.movementDrawing = DrawingAPI.new("Text"); self.movementDrawing.Size=13; self.movementDrawing.Color=Color3.fromRGB(150,255,150); self.movementDrawing.Outline=true end
    local lp = game:GetService("Players").LocalPlayer
    if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return end
    local vel = lp.Character.HumanoidRootPart.AssemblyLinearVelocity
    local speed = math.floor(Vector3.new(vel.X, 0, vel.Z).Magnitude)
    self.movementDrawing.Text = string.format("Speed: %d studs/s", speed)
    self.movementDrawing.Position = Vector2.new(10, 100); self.movementDrawing.Visible = true
end

