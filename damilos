function P.KeyValid(key)
    if not key or key == "" then return false, "Пустой ключ" end
    local data = P.Keys[key]
    if not data then return false, "Неверный ключ" end
    if data.expires == "forever" then return true, "Навсегда" end
    if os.time() > data.expires then return false, "Ключ истёк" end
    local days = math.floor((data.expires - os.time()) / 86400)
    return true, days .. " дней осталось"
end

