print("[void] Loading modules from GitHub...")

-- 1. Загружаем UI библиотеку (Rayfield)
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Window = Rayfield:CreateWindow({
   Name = "void | 120 Functions",
   LoadingTitle = "Загрузка void...",
   LoadingSubtitle = "by void",
   ConfigurationSaving = {Enabled = false},
   KeySystem = false
})

-- 2. Загружаем модули с GitHub
local baseUrl = "https://raw.githubusercontent.com/ddwqaso-cpu/damari/refs/heads/main/"
local CombatModule = loadstring(game:HttpGet(baseUrl .. "combat.lua"))()
local Visual1Module = loadstring(game:HttpGet(baseUrl .. "visual1.lua"))()
local Visual2Module = loadstring(game:HttpGet(baseUrl .. "visual2.lua"))()
local MiscModule = loadstring(game:HttpGet(baseUrl .. "misc.lua"))()

-- 3. Инициализация объектов
local env = {}
local combat = CombatModule.new(env)
local visual = Visual1Module.new(env)

-- Объединяем Visual1 и Visual2 в один объект
for k, v in pairs(Visual2Module) do
    if type(v) == "function" and k ~= "new" and k ~= "applyPart2" then
        visual[k] = v
    end
end

local misc = MiscModule.new(env)

